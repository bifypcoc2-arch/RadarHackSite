<Window x:Class="Foresight.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foresight Launcher" Width="1120" Height="720"
        MinWidth="920" MinHeight="620" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="Transparent"
        AllowsTransparency="True" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="#77859A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#111A26" />
                                <Setter Property="Foreground" Value="#F4F7FB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="54" />
            <Setter Property="Background" Value="{StaticResource RedBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="18,0">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Text="→" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#FF6873" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowCard" Margin="18" Background="{StaticResource BackgroundBrush}" BorderBrush="#33455C" BorderThickness="1" CornerRadius="8">
        <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.55" Color="#000000" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="38" /></Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#070A0F" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Border Width="28" Height="28" Background="{StaticResource BlueBrush}"><TextBlock Text="F" Foreground="White" FontWeight="Black" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Text="FORE" Foreground="White" FontWeight="Bold" FontSize="13" Margin="11,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="SIGHT" Foreground="#6AA2FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                        <Border Width="1" Height="16" Background="#28364A" Margin="13,0" />
                        <TextBlock Text="NATIVE LAUNCHER / 2.1" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"><Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" /><TextBlock Text=" SYSTEM READY" Foreground="#69DDB1" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center" /></StackPanel>
                        <Button Style="{StaticResource WindowButton}" Content="—" Click="Minimize_Click" />
                        <Button Style="{StaticResource WindowButton}" Content="×" Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="MainContent" Grid.Row="1" Opacity="0">
                <Grid.RenderTransform><TranslateTransform Y="18" /></Grid.RenderTransform>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="58,48,52,40">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="MATCH ACCESS TERMINAL" Foreground="#FF747E" FontFamily="Consolas" FontWeight="Bold" FontSize="10" CharacterSpacing="140" />
                    <TextBlock Grid.Row="1" Text="YOUR MATCH.&#x0a;ONE LINK." Foreground="{StaticResource TextBrush}" FontFamily="Arial" FontWeight="Black" FontSize="64" LineHeight="57" Margin="0,19,0,18" />
                    <TextBlock Grid.Row="2" Text="Enter the username and session ID created by your private server. Foresight verifies the match and opens its personal radar." Foreground="#8794A6" FontFamily="Segoe UI" FontSize="14" TextWrapping="Wrap" LineHeight="23" MaxWidth="520" HorizontalAlignment="Left" />

                    <Grid Grid.Row="3" Margin="0,32,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="01 / PLAYER USERNAME" Foreground="#65748A" FontFamily="Consolas" FontWeight="Bold" FontSize="9" Margin="0,0,0,8" /><Border Height="54" BorderBrush="#2A3A50" BorderThickness="1" Background="#070B11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="@" Foreground="#5996F8" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" /><TextBox x:Name="UsernameInput" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" FontFamily="Consolas" FontSize="14" VerticalContentAlignment="Center" CaretBrush="White" /></Grid></Border></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="02 / SESSION ID" Foreground="#65748A" FontFamily="Consolas" FontWeight="Bold" FontSize="9" Margin="0,0,0,8" /><Border Height="54" BorderBrush="#2A3A50" BorderThickness="1" Background="#070B11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="#" Foreground="#5996F8" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" /><TextBox x:Name="SessionInput" Grid.Column="1" MaxLength="8" CharacterCasing="Upper" Background="Transparent" Foreground="White" BorderThickness="0" FontFamily="Consolas" FontSize="14" VerticalContentAlignment="Center" CaretBrush="White" /></Grid></Border></StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4" Margin="0,15,0,0">
                        <TextBlock x:Name="StatusText" Text="ENTER PLAYER AND SESSION ID" Foreground="#65748A" FontFamily="Consolas" FontSize="9" Margin="0,0,0,9" />
                        <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Content="CONNECT TO RADAR" Click="Connect_Click" />
                    </StackPanel>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="OPEN TEST MODE" Foreground="#78869A" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="9" Cursor="Hand" Click="OpenDemo_Click" />
                        <TextBlock Text="/" Foreground="#344256" Margin="16,0" />
                        <Button Content="CONTROL CENTER" Foreground="#78869A" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="9" Cursor="Hand" Click="OpenDashboard_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Column="1" Background="#070B11" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="28">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /><RowDefinition Height="184" /><RowDefinition Height="48" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0"><TextBlock Text="SESSION PIPELINE" Foreground="#65748A" FontFamily="Consolas" FontWeight="Bold" FontSize="9" /><TextBlock Text="READY" Foreground="{StaticResource GreenBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="9" HorizontalAlignment="Right" /></Grid>
                        <Border Grid.Row="1" BorderBrush="#1D2B3D" BorderThickness="1" Background="#080F18" Margin="0,0,0,20">
                            <Grid><Path Stroke="#263C57" StrokeThickness="1" Data="M 30,160 L 120,60 L 225,95 L 330,35 L 410,140 L 315,230 L 170,205 Z" Stretch="Fill" Margin="52" /><Path Stroke="#397DF6" StrokeThickness="2" Data="M 88,210 L 170,155 L 245,115 L 320,82" StrokeDashArray="5,5" /><Ellipse Width="12" Height="12" Fill="#397DF6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="82,0,0,74" /><Ellipse Width="12" Height="12" Fill="#FF515D" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,78,90,0" /><Border Width="52" Height="52" Background="#397DF6"><TextBlock Text="F" Foreground="White" FontWeight="Black" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></Grid>
                        </Border>
                        <StackPanel Grid.Row="2">
                            <Border BorderBrush="#1B283A" BorderThickness="0,1,0,0" Padding="0,11"><Grid><TextBlock Text="01   PRIVATE SERVER" Foreground="#D5DCE6" FontFamily="Consolas" FontWeight="Bold" FontSize="10" /><TextBlock Text="READY" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="9" /></Grid></Border>
                            <Border BorderBrush="#1B283A" BorderThickness="0,1,0,0" Padding="0,11"><Grid><TextBlock Text="02   REALTIME GATEWAY" Foreground="#D5DCE6" FontFamily="Consolas" FontWeight="Bold" FontSize="10" /><TextBlock Text="READY" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="9" /></Grid></Border>
                            <Border BorderBrush="#1B283A" BorderThickness="0,1,0,1" Padding="0,11"><Grid><TextBlock Text="03   RADAR CLIENT" Foreground="#D5DCE6" FontFamily="Consolas" FontWeight="Bold" FontSize="10" /><TextBlock x:Name="ClientStatus" Text="STANDBY" Foreground="#F5C768" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="9" /></Grid></Border>
                        </StackPanel>
                        <Border Grid.Row="3" Background="#0C131E" BorderBrush="#397DF6" BorderThickness="3,0,0,0" Padding="12"><Grid><TextBlock Text="SESSION FORMAT" Foreground="#59687B" FontFamily="Consolas" FontSize="8" VerticalAlignment="Center" /><TextBlock Text="/radar/KITE/F8K2P7Q4" Foreground="#A9B6C6" FontFamily="Consolas" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="#06090E" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="5" Height="5" Fill="{StaticResource GreenBrush}" /><TextBlock Text="  API LINKED     •     SESSION ISOLATION     •     WIN-X64" Foreground="#5C6A7D" FontFamily="Consolas" FontSize="8" /></StackPanel><TextBlock Text="FORESIGHT / BUILD 2.1.0" Foreground="#4F5D70" FontFamily="Consolas" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
            </Border>
        </Grid>
    </Border>
</Window>
