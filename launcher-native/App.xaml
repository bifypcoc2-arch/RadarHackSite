<Application x:Class="Foresight.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#05070A" />
        <SolidColorBrush x:Key="PanelBrush" Color="#080D14" />
        <SolidColorBrush x:Key="LineBrush" Color="#27384E" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#77859A" />
        <SolidColorBrush x:Key="BlueBrush" Color="#397DF6" />
        <SolidColorBrush x:Key="RedBrush" Color="#FF515D" />
        <SolidColorBrush x:Key="GreenBrush" Color="#48D69D" />
    </Application.Resources>
</Application>
